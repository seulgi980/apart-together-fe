# 로컬 개발용 예시. 이 파일을 .env.local 로 복사해서 값을 채운다. (.env.local 은 git에 올라가지 않는다)
# 값을 바꾸면 npm run dev 를 다시 시작해야 한다.
#
# 운영(EC2)에서는 이 파일을 쓰지 않는다. GitHub 저장소의 Actions Secrets / Variables 에 넣은 값이
# 도커 이미지를 빌드할 때 들어간다. (.github/workflows/deploy.yml)

# 백엔드 주소. 비워 두면 http://localhost:8080
NEXT_PUBLIC_API_URL=

# 지도 화면용 구글 지도 키 (브라우저에 보이는 값)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 구글 지도 ID. 비워 두면 테스트용 DEMO_MAP_ID
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
